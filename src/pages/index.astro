---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lovelace Engineering — Sovereign AI Infrastructure for Europe">
  <!-- Nav -->
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <span class="logo-icon">◆</span>
        <span>Lovelace Engineering</span>
      </a>
      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#ai">AI Infrastructure</a>
        <a href="#sovereign">Sovereign Cloud</a>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact" class="btn btn-primary btn-sm">Get in Touch</a>
      </div>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="mobile-menu" id="mobile-menu" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <div class="hero-badge fade-in">🇪🇺 European Digital Sovereignty</div>
      <h1 class="hero-title fade-in">
        Sovereign <span class="gradient-text">AI-Native</span><br/>Infrastructure for Europe
      </h1>
      <p class="hero-subtitle fade-in">
        We architect cloud-native platforms and AI inference infrastructure that keeps European data sovereign, compliant, and performant at scale.
      </p>
      <div class="hero-actions fade-in">
        <a href="#contact" class="btn btn-primary">Start a Conversation →</a>
        <a href="#services" class="btn btn-secondary">Explore Services</a>
      </div>
      <div class="hero-stats fade-in">
        <div class="stat"><span class="stat-value">15+</span><span class="stat-label">Years Experience</span></div>
        <div class="stat"><span class="stat-value">CNCF</span><span class="stat-label">Ecosystem Expert</span></div>
        <div class="stat"><span class="stat-value">EU</span><span class="stat-label">Data Sovereign</span></div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <p class="section-label fade-in">What We Do</p>
      <h2 class="section-title fade-in">Engineering at the Intersection of<br/><span class="gradient-text">Cloud Native, AI & Sovereignty</span></h2>
      <p class="section-subtitle fade-in">Deep technical expertise across the entire cloud-native stack, from Kubernetes internals to GPU scheduling for large-scale AI inference.</p>
      <div class="services-grid">
        <div class="card fade-in">
          <div class="card-icon">⚙️</div>
          <h3>Platform Engineering</h3>
          <p>Internal Developer Platforms, golden paths, self-service infrastructure. Backstage, Kratix, Crossplane.</p>
        </div>
        <div class="card fade-in">
          <div class="card-icon">☸️</div>
          <h3>Kubernetes at Scale</h3>
          <p>Multi-cluster fleet management, service mesh (Istio, Cilium), eBPF networking, GitOps with Flux & ArgoCD.</p>
        </div>
        <div class="card fade-in">
          <div class="card-icon">🤖</div>
          <h3>AI Infrastructure</h3>
          <p>GPU inference platforms, llm-d, vLLM, multi-GPU scheduling, model serving at scale on Kubernetes.</p>
        </div>
        <div class="card fade-in">
          <div class="card-icon">🔒</div>
          <h3>Cloud-Native Security</h3>
          <p>Runtime protection with Falco, policy engines (OPA, Kyverno), supply chain security, zero-trust architectures.</p>
        </div>
        <div class="card fade-in">
          <div class="card-icon">🇪🇺</div>
          <h3>Sovereign Cloud</h3>
          <p>GDPR-compliant infrastructure, EU data residency, NIS2 compliance, Gaia-X integration.</p>
        </div>
        <div class="card fade-in">
          <div class="card-icon">🔄</div>
          <h3>MLOps & LLMOps</h3>
          <p>End-to-end ML pipelines, fine-tuning infrastructure, RAG systems, vector databases on Kubernetes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Infrastructure Spotlight -->
  <section class="section section-alt" id="ai">
    <div class="container">
      <p class="section-label fade-in">Deep Dive</p>
      <h2 class="section-title fade-in">AI Infrastructure<br/><span class="gradient-text">Built for Production</span></h2>
      <p class="section-subtitle fade-in">From GPU clusters to intelligent routing — we build the infrastructure that makes AI work at enterprise scale.</p>

      <div class="ai-grid">
        <div class="ai-card glass-card fade-in">
          <h4>🚀 Inference at Scale</h4>
          <ul>
            <li>llm-d — Kubernetes-native LLM inference daemon</li>
            <li>vLLM & TGI deployment patterns</li>
            <li>Triton Inference Server orchestration</li>
            <li>NVIDIA GPU Operator & MIG scheduling</li>
          </ul>
        </div>
        <div class="ai-card glass-card fade-in">
          <h4>🧠 Agentic AI</h4>
          <ul>
            <li>Agentic orchestration on Kubernetes</li>
            <li>AI Gateway & routing patterns (LiteLLM)</li>
            <li>Multi-model inference pipelines</li>
            <li>Autoscaling based on token throughput</li>
          </ul>
        </div>
        <div class="ai-card glass-card fade-in">
          <h4>📊 RAG & Data</h4>
          <ul>
            <li>Vector databases (Qdrant, Weaviate, Milvus)</li>
            <li>Embedding pipelines at scale</li>
            <li>Retrieval-augmented generation infra</li>
            <li>Knowledge graph integration</li>
          </ul>
        </div>
        <div class="ai-card glass-card fade-in">
          <h4>🔧 MLOps & Fine-tuning</h4>
          <ul>
            <li>Distributed training on Kubernetes</li>
            <li>LoRA/QLoRA fine-tuning pipelines</li>
            <li>Model registry & versioning</li>
            <li>Continuous evaluation & monitoring</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sovereign Cloud -->
  <section class="section" id="sovereign">
    <div class="container">
      <div class="sovereign-layout">
        <div class="sovereign-text">
          <p class="section-label fade-in">European First</p>
          <h2 class="section-title fade-in">Digital Sovereignty<br/><span class="gradient-text">By Design</span></h2>
          <p class="section-subtitle fade-in">Infrastructure that respects European values. Data stays in Europe, compliance is built-in, and sovereignty isn't an afterthought.</p>
          <div class="sovereign-list fade-in">
            <div class="sovereign-item"><span>✓</span> GDPR-compliant by architecture</div>
            <div class="sovereign-item"><span>✓</span> EU data residency guarantees</div>
            <div class="sovereign-item"><span>✓</span> NIS2 Directive readiness</div>
            <div class="sovereign-item"><span>✓</span> EU AI Act compliance infrastructure</div>
            <div class="sovereign-item"><span>✓</span> Gaia-X ecosystem integration</div>
            <div class="sovereign-item"><span>✓</span> European providers: Scaleway, OVH, Hetzner</div>
          </div>
        </div>
        <div class="sovereign-visual fade-in">
          <div class="glass-card sovereign-card">
            <div class="eu-flag">🇪🇺</div>
            <h4>Data never leaves the EU</h4>
            <p>Every component — compute, storage, networking — runs on European soil with European providers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section section-alt" id="about">
    <div class="container">
      <p class="section-label fade-in">Who We Are</p>
      <h2 class="section-title fade-in">Deep Expertise,<br/><span class="gradient-text">Proven Track Record</span></h2>
      <div class="about-content fade-in">
        <div class="about-card glass-card">
          <h3>Alessandro Vozza</h3>
          <p class="about-role">Founder & Principal Consultant</p>
          <p>15+ years building cloud infrastructure at scale. From Microsoft to startups, from bare metal to serverless — and now focused on making AI infrastructure work for European organizations.</p>
          <div class="credentials">
            <span class="credential">🏅 Golden Kubestronaut</span>
            <span class="credential">🎤 KubeCon Speaker</span>
            <span class="credential">🎓 PhD</span>
            <span class="credential">☁️ CNCF Ambassador</span>
            <span class="credential">📜 CKA/CKAD/CKS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section" id="values">
    <div class="container">
      <p class="section-label fade-in">Our Principles</p>
      <h2 class="section-title fade-in">Built on <span class="gradient-text">Values</span></h2>
      <div class="values-grid">
        <div class="card fade-in">
          <h3>🌍 Open Source First</h3>
          <p>We build on and contribute to open source. No vendor lock-in, no black boxes.</p>
        </div>
        <div class="card fade-in">
          <h3>🛡️ Security by Default</h3>
          <p>Zero-trust, least privilege, defense in depth. Security isn't a feature — it's the foundation.</p>
        </div>
        <div class="card fade-in">
          <h3>📐 Engineering Excellence</h3>
          <p>Clean architectures, reproducible infrastructure, documentation that matters.</p>
        </div>
        <div class="card fade-in">
          <h3>🤝 Knowledge Transfer</h3>
          <p>We don't just build — we teach. Your team owns the platform when we're done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects">
    <div class="container">
      <p class="section-label fade-in">Open Source</p>
      <h2 class="section-title fade-in">Our <span class="gradient-text">Projects</span></h2>
      <p class="section-subtitle fade-in">Tools, platforms, and training materials we've built — all open source.</p>
      <div class="projects-grid">
        <a href="https://cloud-repatriation.lovelace.engineering" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🔄</div>
          <h3>Cloud Repatriation Tool</h3>
          <p>Interactive assessment for cloud-to-on-prem migration decisions. Cost modeling, risk analysis, and migration readiness scoring.</p>
          <div class="project-links">
            <span class="project-link">cloud-repatriation.lovelace.engineering ↗</span>
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/cloud-repatriation-tool" target="_blank" onclick="event.stopPropagation()">Source</a></span>
          </div>
        </a>
        <a href="https://mcpskills.dev" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🔌</div>
          <h3>MCPSkills.dev</h3>
          <p>The largest directory of MCP (Model Context Protocol) servers. Search, discover, and compare MCP servers for AI agents.</p>
          <div class="project-links">
            <span class="project-link">mcpskills.dev ↗</span>
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/mcpskills" target="_blank" onclick="event.stopPropagation()">Source</a></span>
          </div>
        </a>
        <a href="https://mission-control.lovelace.engineering" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🎛️</div>
          <h3>Mission Control</h3>
          <p>Dashboard UI for managing OpenClaw AI agents. Monitor tools, agents, logs, and settings in one place.</p>
          <div class="project-links">
            <span class="project-link">mission-control.lovelace.engineering ↗</span>
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/mission-control" target="_blank" onclick="event.stopPropagation()">Source</a></span>
          </div>
        </a>
        <a href="https://github.com/LovelaceEngineering/projects/tree/main/openclaw-prometheus-exporter" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">📊</div>
          <h3>Prometheus Exporter</h3>
          <p>Prometheus metrics exporter for OpenClaw AI token usage and cost tracking. Ready for Grafana dashboards.</p>
          <div class="project-links">
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/openclaw-prometheus-exporter" target="_blank" onclick="event.stopPropagation()">Source ↗</a></span>
          </div>
        </a>
        <a href="https://k8s-course.lovelace.engineering" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">☸️</div>
          <h3>K8s Course</h3>
          <p>Intensive Kubernetes training course in Italian. 9 sessions, from Linux namespaces to GitOps production-ready.</p>
          <div class="project-links">
            <span class="project-link">k8s-course.lovelace.engineering ↗</span>
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/k8s-course" target="_blank" onclick="event.stopPropagation()">Source</a></span>
          </div>
        </a>
        <a href="https://letsclaude.lovelace.engineering" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🤖</div>
          <h3>LetsClaude</h3>
          <p>Training and consulting for the Anthropic Claude platform. Courses on Claude Code, Agent SDK, and Claude API.</p>
          <div class="project-links">
            <span class="project-link">letsclaude.lovelace.engineering ↗</span>
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/letsclaude" target="_blank" onclick="event.stopPropagation()">Source</a></span>
          </div>
        </a>
        <a href="https://github.com/LovelaceEngineering/projects/tree/main/network-monitor" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🌐</div>
          <h3>Network Monitor</h3>
          <p>Full-stack network monitoring with Zeek, Elasticsearch & Kibana. Captures every connection, alerts on anomalies.</p>
          <div class="project-links">
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/network-monitor" target="_blank" onclick="event.stopPropagation()">Source ↗</a></span>
          </div>
        </a>
        <a href="https://github.com/LovelaceEngineering/projects/tree/main/genai-k8s-workshop" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">🧠</div>
          <h3>GenAI K8s Workshop</h3>
          <p>Hands-on GenAI on Kubernetes workshop. Deploy LLMs with vLLM, KServe, KAITO, llm-d, and Gateway API.</p>
          <div class="project-links">
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/genai-k8s-workshop" target="_blank" onclick="event.stopPropagation()">Source ↗</a></span>
          </div>
        </a>
        <a href="https://github.com/LovelaceEngineering/projects/tree/main/trading-bot" target="_blank" class="project-card glass-card fade-in">
          <div class="project-icon">📈</div>
          <h3>Trading Bot</h3>
          <p>Pure Python DCA trading bot for Coinbase Advanced Trade. Deterministic rules, no LLM — designed for automated investing.</p>
          <div class="project-links">
            <span class="project-source"><a href="https://github.com/LovelaceEngineering/projects/tree/main/trading-bot" target="_blank" onclick="event.stopPropagation()">Source ↗</a></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section-alt" id="contact">
    <div class="container">
      <p class="section-label fade-in">Let's Talk</p>
      <h2 class="section-title fade-in">Ready to Build<br/><span class="gradient-text">Something Great?</span></h2>
      <p class="section-subtitle fade-in">Whether you're planning a sovereign cloud migration, deploying AI at scale, or building an internal platform — let's discuss how we can help.</p>
      <div class="contact-form-wrapper fade-in">
        <form class="contact-form glass-card" action="https://formspree.io/f/xpwzgkdl" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="you@company.eu" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" placeholder="Your organization" />
            </div>
            <div class="form-group">
              <label for="interest">Interest</label>
              <select id="interest" name="interest">
                <option value="">Select area of interest</option>
                <option value="sovereign-cloud">Sovereign Cloud & EU Compliance</option>
                <option value="ai-infrastructure">AI Infrastructure</option>
                <option value="platform-engineering">Platform Engineering</option>
                <option value="kubernetes">Kubernetes & Cloud Native</option>
                <option value="security">Cloud-Native Security</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="Tell us about your project..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send Message →</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="logo-icon">◆</span>
        <span>Lovelace Engineering</span>
        <p class="footer-tagline">Sovereign AI-Native Infrastructure for Europe 🇪🇺</p>
      </div>
      <div class="footer-links">
        <a href="#services">Services</a>
        <a href="#ai">AI Infrastructure</a>
        <a href="#sovereign">Sovereign Cloud</a>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="footer-social">
        <a href="https://github.com/ams0" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/intfrr" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://twitter.com/intfrr" target="_blank" rel="noopener">X/Twitter</a>
      </div>
      <div class="footer-bottom">
        <p>© 2025 Lovelace Engineering. Amsterdam, Netherlands.</p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Nav */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }
  .logo-icon {
    font-size: 1.4rem;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); }
  .btn-sm { padding: 10px 20px; font-size: 0.8125rem; }

  .theme-toggle {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text-secondary);
    transition: all var(--transition);
    margin-left: 16px;
  }
  .theme-toggle:hover {
    border-color: var(--border-hover);
    color: var(--text);
  }
  [data-theme="dark"] .icon-moon { display: none; }
  [data-theme="light"] .icon-sun { display: none; }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .mobile-menu span {
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
  }

  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 80px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, var(--accent-glow), transparent),
      radial-gradient(ellipse 60% 40% at 80% 20%, rgba(139, 92, 246, 0.1), transparent);
  }
  .hero-content {
    position: relative;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-block;
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 80px;
  }
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 64px;
  }
  .stat { text-align: center; }
  .stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text);
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .card-icon {
    font-size: 2rem;
    margin-bottom: 16px;
  }
  .card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* AI Grid */
  .section-alt {
    background: var(--bg-secondary);
  }
  .ai-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .ai-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .ai-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ai-card li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding-left: 16px;
